  "buffs": [
    {
      "id": "69000066",
      "name": "United Strength",
      "description": "If there are 2/3 Agents in the squad with Anomaly specialty, the whole squad's Anomaly Proficiency increases by 30/70 respectively, and Attribute Anomaly DMG dealt increases by 10%/25% respectively.\nAfter inflicting an Attribute Anomaly on an enemy, the enemy's All-Attribute RES is reduced by 15% for 10s. Repeated triggers reset the duration."
    },
    {
      "id": "69000068",
      "name": "Frost Reins",
      "description": "For Agents with Attack specialty, their ATK increases by 25%. When their Basic Attack, EX Special Attack, or Chain Attack hits an enemy, it ignores 30% of the target's Ice RES and Ether RES.\nWhen an Agent hits a Stunned enemy, the target's Stun DMG Multiplier increases by 40% for 5s. Repeated triggers reset the duration."
    },
    {
      "id": "69000055",
      "name": "Breakthrough",
      "description": "Rupture specialty Agent Sheer DMG increases by 15%, and reduces Miasma Shield 30% faster.\nWhile in Ether Veil, Agent Ether DMG increases by 25%, and hitting an enemy makes its Stun DMG Multiplier increase by 25% for 10s. Repeated triggers reset the duration."
    }
  ],
